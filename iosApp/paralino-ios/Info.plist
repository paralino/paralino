<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSEncryptionExportComplianceCode</key>
	<string>$(encryptionExportCompliance)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.paralino.ios.task.refresh.full</string>
		<string>app.paralino.ios.task.refresh.notifications</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>hr</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>osmandmaps</string>
		<string>waze</string>
		<string>here-route</string>
		<string>com.sygic.aura</string>
		<string>citymapper</string>
		<string>yandexmaps</string>
		<string>moovit</string>
		<string>maps</string>
	</array>
	<key>TEAM_ID</key>
	<string>$(TEAM_ID)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>forceLogToSystem</key>
	<string>$(forceLogToSystem)</string>
	<key>internalTesting</key>
	<string>$(internalTesting)</string>
	<key>paralinoPublicServerUrl</key>
	<string>$(publicServerUrl)</string>
	<key>paralinoServerKey</key>
	<string>$(serverKey)</string>
	<key>paralinoServerUrl</key>
	<string>$(serverUrl)</string>
	<key>revenueCatApiKey</key>
	<string>$(revenueCatApiKey)</string>
</dict>
</plist>
