CREATE TABLE IF NOT EXISTS groupMembersKeysEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`groupId` TEXT NOT NULL,
`ownerUserId` TEXT NOT NULL,
`memberKeyVersion` INTEGER NOT NULL,
`signedMembershipPublicKey` TEXT NOT NULL,
`signedMemberKxPublicKey` TEXT NOT NULL,
`ownerIdentityKey` TEXT NOT NULL
);

createGroupMemberKey:
INSERT OR REPLACE INTO groupMembersKeysEntity
VALUES ?;

getAll:
SELECT * FROM groupMembersKeysEntity;

deleteForGroup:
DELETE FROM groupMembersKeysEntity
WHERE groupMembersKeysEntity.groupId = ?;

deleteForMember:
DELETE FROM groupMembersKeysEntity
WHERE groupId = :groupId
AND ownerUserId = :userId;

clearAll:
DELETE FROM groupMembersKeysEntity;