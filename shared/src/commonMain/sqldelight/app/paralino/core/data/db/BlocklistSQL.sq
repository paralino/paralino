CREATE TABLE IF NOT EXISTS blocklistEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`ownerUserId` TEXT NOT NULL,
`resourceType` TEXT NOT NULL,
`resourceId` TEXT NOT NULL,
`data` TEXT
);

createBlocklist:
INSERT OR REPLACE INTO blocklistEntity
VALUES ?;

getForId:
SELECT * FROM blocklistEntity
WHERE id = :id;

getAll:
SELECT * FROM blocklistEntity;

remove:
DELETE FROM blocklistEntity
WHERE id = :id;

clearAll:
DELETE FROM blocklistEntity;