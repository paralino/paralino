CREATE TABLE IF NOT EXISTS memberEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`userId` TEXT NOT NULL,
`groupId` TEXT NOT NULL,
`groupKeyVersion` INTEGER NOT NULL,
`memberKeyVersion` INTEGER NOT NULL,
`verification` TEXT NOT NULL,
`data` TEXT NOT NULL,
`settings_id` TEXT,
`settings_ownerUserId` TEXT,
`settings_groupId` TEXT,
`settings_integrity` TEXT
);


create:
INSERT OR REPLACE INTO memberEntity
VALUES ?;

getAllMembersForGroup:
SELECT * FROM memberEntity
WHERE groupId = :groupId;

getAllMembersForUser:
SELECT * FROM memberEntity
WHERE memberEntity.userId = :userId;

getMemberById:
SELECT * FROM memberEntity
WHERE memberEntity.id = :memberId;

getMember:
SELECT * FROM memberEntity
WHERE memberEntity.groupId = :groupId
AND memberEntity.userId = :userId;

getUserMemberId:
SELECT memberEntity.id FROM memberEntity
WHERE memberEntity.groupId = :groupId
AND memberEntity.userId = :userId;

getMemberCount:
SELECT COUNT(memberEntity.id) FROM memberEntity
WHERE memberEntity.groupId = :groupId;

deleteMember:
DELETE FROM memberEntity
WHERE memberEntity.groupId = :groupId
AND memberEntity.userId = :userId;

clearForGroup:
DELETE FROM memberEntity
WHERE groupId = :groupId;

clearAll:
DELETE FROM memberEntity;