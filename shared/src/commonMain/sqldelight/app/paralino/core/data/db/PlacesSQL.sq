CREATE TABLE IF NOT EXISTS placeEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`groupId` TEXT NOT NULL,
`ownerUserId` TEXT NOT NULL,
`groupKeyVersion` INTEGER NOT NULL,
`privatePlace` INTEGER AS kotlin.Boolean NOT NULL,
`data` TEXT NOT NULL
);

createPlace:
INSERT OR REPLACE INTO placeEntity
VALUES ?;

getPlace:
SELECT * FROM placeEntity
WHERE id = ?;

getAll:
SELECT * FROM placeEntity;

getAllForGroup:
SELECT * FROM placeEntity
WHERE groupId = :groupId;

getPlacesCount:
SELECT COUNT(id) FROM placeEntity;

deletePlace:
DELETE FROM placeEntity
WHERE id = :placeId;

deleteForGroup:
DELETE FROM placeEntity
WHERE groupId = :groupId;

clearAll:
DELETE FROM placeEntity;