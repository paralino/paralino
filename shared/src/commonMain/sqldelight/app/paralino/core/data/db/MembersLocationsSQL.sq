CREATE TABLE IF NOT EXISTS memberLocationEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`groupId` TEXT NOT NULL,
`memberId` TEXT NOT NULL,
`userId` TEXT NOT NULL,
`deviceId` TEXT NOT NULL,
`groupKeyVersion` INTEGER NOT NULL,
`deviceKeyVersion` INTEGER NOT NULL,
`deviceData` TEXT,
`locationData` TEXT,
`status` TEXT
);

create:
INSERT OR REPLACE INTO memberLocationEntity
VALUES ?;

updateLocationData:
UPDATE OR IGNORE memberLocationEntity
SET locationData = :locationData
WHERE id = :id;

update:
UPDATE OR IGNORE memberLocationEntity
SET deviceId = :deviceId,
 deviceData = :deviceData,
 groupKeyVersion = :groupKeyVersion,
 deviceKeyVersion = :deviceKeyVersion,
 locationData = :locationData,
 status = :status
WHERE id = :id;

getForMember:
SELECT * FROM memberLocationEntity
WHERE memberId = :memberId;

getLocationCountForMember:
SELECT COUNT(id) FROM memberLocationEntity
WHERE memberId = :memberId;

getForUser:
SELECT * FROM memberLocationEntity
WHERE memberLocationEntity.userId = :userId;

getForGroup:
SELECT * FROM memberLocationEntity
WHERE memberLocationEntity.groupId = :groupId;

clearForGroup:
DELETE FROM memberLocationEntity
WHERE groupId = :groupId;

clearForMember:
DELETE FROM memberLocationEntity
WHERE memberId = :memberId;

clearForUserInGroup:
DELETE FROM memberLocationEntity
WHERE memberLocationEntity.groupId = :groupId
AND memberLocationEntity.userId = :userId;

clearAll:
DELETE FROM memberLocationEntity;