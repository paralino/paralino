CREATE TABLE IF NOT EXISTS groupKeysEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`groupId` TEXT NOT NULL,
`memberUserId` TEXT NOT NULL,
`groupKeyVersion` INTEGER NOT NULL,
`memberKeyVersion` INTEGER NOT NULL,
`encryptedGroupKey` TEXT NOT NULL
);

createGroupKey:
INSERT OR REPLACE INTO groupKeysEntity
VALUES ?;

getAll:
SELECT * FROM groupKeysEntity;

deleteForGroup:
DELETE FROM groupKeysEntity
WHERE groupKeysEntity.groupId = ?;

clearAll:
DELETE FROM groupKeysEntity;