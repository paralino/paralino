CREATE TABLE pendingPlaceEventsEntity (
`id` INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
`placeId` TEXT NOT NULL,
`groupId` TEXT NOT NULL,
`isEnter` INTEGER AS kotlin.Boolean NOT NULL,
`notifyTimeMillis` INTEGER NOT NULL
);

createPendingEvent:
INSERT INTO pendingPlaceEventsEntity (placeId, groupId, isEnter, notifyTimeMillis)
VALUES (?, ?, ?, ?);

getAll:
SELECT * FROM pendingPlaceEventsEntity;

deleteEvent:
DELETE FROM pendingPlaceEventsEntity
WHERE id = :id;

deleteForPlace:
DELETE FROM pendingPlaceEventsEntity
WHERE placeId = :placeId;

deleteForGroup:
DELETE FROM pendingPlaceEventsEntity
WHERE groupId = :groupId;

deleteObsoleteEvents:
DELETE FROM pendingPlaceEventsEntity
WHERE notifyTimeMillis < :maxPendingTimeMillis;

clearAll:
DELETE FROM pendingPlaceEventsEntity;