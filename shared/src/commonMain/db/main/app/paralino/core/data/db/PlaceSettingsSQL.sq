CREATE TABLE IF NOT EXISTS placeSettingsEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`groupId` TEXT NOT NULL,
`placeId` TEXT NOT NULL,
`ownerUserId` TEXT NOT NULL,
`alertData` TEXT NOT NULL
);

createPlaceSettings:
INSERT OR REPLACE INTO placeSettingsEntity
VALUES ?;

getSettingsForPlace:
SELECT * FROM placeSettingsEntity
WHERE placeId = :placeId;

deleteForPlace:
DELETE FROM placeSettingsEntity
WHERE placeId = :placeId;

deleteForGroup:
DELETE FROM placeSettingsEntity
WHERE groupId = :groupId;

clearAll:
DELETE FROM placeSettingsEntity;