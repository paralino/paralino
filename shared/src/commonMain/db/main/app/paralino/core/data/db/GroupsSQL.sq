CREATE TABLE IF NOT EXISTS groupEntity (
`id` TEXT NOT NULL PRIMARY KEY ,
`ownerUserId` TEXT NOT NULL,
`groupKeyVersion` INTEGER NOT NULL,
`data` TEXT NOT NULL,
`serverIntegrity` TEXT NOT NULL,
`planType` TEXT NOT NULL,
`schemeVersion` TEXT NOT NULL,
`membersLimitOverride` INTEGER DEFAULT NULL,
`devicesLimitOverride` INTEGER DEFAULT NULL,
`placesLimitOverride` INTEGER DEFAULT NULL,
`planExpiresAt` TEXT DEFAULT NULL,
`provider` TEXT DEFAULT NULL,
`fallbackPlanType` TEXT DEFAULT NULL
);

createGroup:
INSERT OR REPLACE INTO groupEntity
VALUES ?;

getGroup:
SELECT * FROM groupEntity
WHERE id = ?;

getGroupOwnerId:
SELECT groupEntity.ownerUserId FROM groupEntity
WHERE id = :groupId;

getAllGroups:
SELECT * FROM groupEntity;

getGroupsCount:
SELECT COUNT(id) FROM groupEntity;

getAllGroupIds:
SELECT groupEntity.id FROM groupEntity;

deleteGroup:
DELETE FROM groupEntity
WHERE id = ?;

clearAll:
DELETE FROM groupEntity;
