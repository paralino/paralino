DROP TABLE IF EXISTS subscriptionPlanEntity;
CREATE TABLE IF NOT EXISTS subscriptionPlanEntity (
`id` TEXT NOT NULL PRIMARY KEY,
`planType` TEXT NOT NULL,
`billingPeriod` TEXT NOT NULL,
`groupId` TEXT DEFAULT NULL,
`ownerUserId` TEXT DEFAULT NULL,
`expiresAt` TEXT DEFAULT NULL,
`groupsLimitOverride` INTEGER DEFAULT NULL,
`provider` TEXT DEFAULT NULL
);
ALTER TABLE groupEntity ADD COLUMN membersLimitOverride INTEGER DEFAULT NULL;
ALTER TABLE groupEntity ADD COLUMN devicesLimitOverride INTEGER DEFAULT NULL;
ALTER TABLE groupEntity ADD COLUMN placesLimitOverride INTEGER DEFAULT NULL;