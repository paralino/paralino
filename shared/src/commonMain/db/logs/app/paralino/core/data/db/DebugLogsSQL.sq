CREATE TABLE IF NOT EXISTS debugLogsEntity (
`id` INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
`timeUTC` TEXT NOT NULL,
`type` TEXT NOT NULL,
`priority` INTEGER NOT NULL,
`tag` TEXT NOT NULL,
`title` TEXT NOT NULL,
`info` TEXT DEFAULT NULL,
`host` TEXT DEFAULT NULL
);

insertEntry:
INSERT INTO debugLogsEntity (timeUTC, type, priority, tag, title, info, host)
VALUES (?, ?, ?, ?, ?, ?, ?);

getFiltered:
SELECT * FROM debugLogsEntity
WHERE
    (:typesNullIfEmpty IS 1 OR type IN :types) AND
    (:tagsNullIfEmpty IS 1 OR tag IN :tags) AND
    (:hostsNullIfEmpty IS 1 OR host IN :hosts) AND
    (:priorityNullIfEmpty IS 1 OR priority IN :priorities) AND
--     CASE WHEN :priority != NULL THEN priority >= :priority ELSE 1 END AND
    (
        title LIKE ('%' || :text || '%') OR
        info LIKE ('%' || :text || '%') OR
        tag LIKE ('%' || :text || '%')
    )
ORDER BY id DESC;

getForOrHigherPriority:
SELECT * FROM debugLogsEntity
WHERE priority >= :priority
ORDER BY id DESC;

getAll:
SELECT * FROM debugLogsEntity
ORDER BY id DESC;

remove:
DELETE FROM debugLogsEntity
WHERE id = :id;

removeOlderThan:
DELETE FROM debugLogsEntity
WHERE timeUTC < :maxValidTimeUTC;

clearAll:
DELETE FROM debugLogsEntity;