CREATE TABLE IF NOT EXISTS debugLogsEntity (
`id` INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
`timeUTC` TEXT NOT NULL,
`type` TEXT NOT NULL,
`priority` INTEGER NOT NULL,
`tag` TEXT NOT NULL,
`title` TEXT NOT NULL,
`info` TEXT DEFAULT NULL
);

insertEntry:
INSERT INTO debugLogsEntity (timeUTC, type, priority, tag, title, info)
VALUES (?, ?, ?, ?, ?, ?);

getForId:
SELECT * FROM debugLogsEntity
WHERE id = :id;

getForType:
SELECT * FROM debugLogsEntity
WHERE type = :type
ORDER BY id DESC;

getForPriority:
SELECT * FROM debugLogsEntity
WHERE priority = :priority
ORDER BY id DESC;

getForOrHigherPriority:
SELECT * FROM debugLogsEntity
WHERE priority >= :priority
ORDER BY id DESC;

getForTag:
SELECT * FROM debugLogsEntity
WHERE tag = :tag
ORDER BY id DESC;

getAll:
SELECT * FROM debugLogsEntity
ORDER BY id DESC;

remove:
DELETE FROM debugLogsEntity
WHERE id = :id;

removeOlderThan:
DELETE FROM debugLogsEntity
WHERE timeUTC < :maxValidTimeUTC;

clearAll:
DELETE FROM debugLogsEntity;