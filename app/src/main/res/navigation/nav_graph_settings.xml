<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_settings"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.zbapp.locationtrack.ui.login.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <deepLink
            android:id="@+id/deepLink"
            app:uri=".*/settings/login" />
    </fragment>

    <dialog
        android:id="@+id/acceptInviteFragment"
        android:name="com.zbapp.locationtrack.ui.invite.AccessCodeInputFragment"
        android:label="AcceptInviteFragment"
        tools:layout="@layout/fragment_invite_accept"
        >
        <argument
            android:name="code"
            app:nullable="true"
            app:argType="string"
            android:defaultValue="@null"
            />
        <argument
            android:name="groupId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <deepLink
            android:id="@+id/deepLink"
            app:uri=".*/invite/{code}" />
    </dialog>


</navigation>