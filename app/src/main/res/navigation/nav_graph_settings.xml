<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_settings"
    app:startDestination="@id/navigation_settings">


    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.zbapp.locationtrack.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings">
        <deepLink
            android:id="@+id/deepLink2"
            app:uri=".*/settings" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.zbapp.locationtrack.ui.login.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <deepLink
            android:id="@+id/deepLink"
            app:uri=".*/settings/login" />
        <action
            android:id="@+id/toEmailConfirmInfo"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:destination="@id/confirmEmailInfoFragment"
            />
    </fragment>

    <fragment
        android:id="@+id/confirmEmailInfoFragment"
        android:name="com.zbapp.locationtrack.ui.login.ConfirmEmailInfoFragment"
        android:label="ConfirmEmailInfoFragment"
        tools:layout="@layout/fragment_generic_info"
        />

    <fragment
        android:id="@+id/manageInviteFragment"
        android:name="com.zbapp.locationtrack.ui.invite.ManageInviteFragment"
        android:label="ManageInviteFragment"
        tools:layout="@layout/fragment_invite_manage"
        >
        <deepLink
            android:id="@+id/deepLink"
            app:uri=".*/settings/invite" />
    </fragment>

    <dialog
        android:id="@+id/acceptInviteFragment"
        android:name="com.zbapp.locationtrack.ui.invite.AcceptInviteFragment"
        android:label="AcceptInviteFragment"
        tools:layout="@layout/fragment_invite_accept"
        >
        <argument
            android:name="code"
            app:nullable="true"
            app:argType="string"
            android:defaultValue="@null"
            />
        <deepLink
            android:id="@+id/deepLink"
            app:uri=".*/invite/{code}" />
    </dialog>


</navigation>