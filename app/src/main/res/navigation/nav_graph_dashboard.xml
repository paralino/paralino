<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_dashboard"
    app:startDestination="@id/sharingStartFragment">

    <fragment
        android:id="@+id/sharingStartFragment"
        android:name="com.zbapp.locationtrack.ui.groups.SharingStartFragment"
        android:label="SharingStartFragment"
        tools:layout="@layout/fragment_sharing_start">
        <argument
            android:name="groupId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.zbapp.locationtrack.ui.groups.detail.GroupDetailFragment"
        tools:layout="@layout/fragment_group_detail"
        android:label="GroupDetailFragment">
        <argument
            android:name="groupId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/groupMembersFragment"
        android:name="com.zbapp.locationtrack.ui.groups.detail.members.GroupMembersFragment"
        tools:layout="@layout/fragment_group_members"
        android:label="GroupMembersFragment">
        <argument
            android:name="groupId"
            app:argType="string" />
        <argument
            android:name="groupName"
            app:argType="string" />
    </fragment>

    <dialog
        android:id="@+id/acceptInviteFragment"
        android:name="com.zbapp.locationtrack.ui.invite.AccessCodeInputFragment"
        android:label="AcceptInviteFragment"
        tools:layout="@layout/fragment_invite_accept"
        >
        <argument
            android:name="code"
            app:nullable="true"
            app:argType="string"
            android:defaultValue="@null"
            />
        <argument
            android:name="groupId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <deepLink
            android:id="@+id/deepLink"
            app:uri=".*/invite/{code}" />
    </dialog>

</navigation>