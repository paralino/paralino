<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/navigation_dashboard"
    android:id="@+id/nav_graph_dashboard">


    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.zbapp.locationtrack.ui.dashboard.DashboardFragment"
        tools:layout="@layout/fragment_dashboard"
        android:label="@string/title_dashboard" />

    <dialog
        android:id="@+id/createGroupFragment"
        android:name="com.zbapp.locationtrack.ui.groups.CreateGroupFragment"
        tools:layout="@layout/fragment_create_group"
        android:label="CreateGroupFragment" />

    <fragment
        android:id="@+id/sharingStartFragment"
        android:name="com.zbapp.locationtrack.ui.groups.SharingStartFragment"
        android:label="SharingStartFragment"
        tools:layout="@layout/fragment_sharing_start"
        >
        <argument
            android:name="groupId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>


</navigation>