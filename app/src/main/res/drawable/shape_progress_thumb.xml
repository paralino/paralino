<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">

            <solid android:color="@color/accentAlpha50" />

            <stroke
                android:width="12dp"
                android:color="@color/accent" />

            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:drawable="@drawable/ic_time_progress_thumb"
        android:gravity="center" >
    </item>
</layer-list>
