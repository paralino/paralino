<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppThemeBase" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/theme_high</item>
        <item name="colorPrimaryVariant">@color/theme_highest</item>
        <item name="colorOnPrimary">@color/theme_light</item>

        <item name="colorSurface">@color/theme_lightest</item>
        <item name="colorOnSurface">@color/theme_highest</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accentDark</item>
        <item name="colorOnSecondary">@color/theme_lightest</item>

        <item name="colorControlHighlight">@color/alpha_grey_highlight</item>

        <item name="android:textColorPrimary">@color/theme_highest</item>
        <item name="android:textColorSecondary">@color/theme_high</item>

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/backgroundMain</item>
        <item name="android:windowLightStatusBar">@bool/app_windowLightNavigationBar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

    </style>

    <style name="AppTheme" parent="AppThemeBase">
    </style>



    <style name="Container.Generic" parent="AppTheme">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_main_rounded_background</item>
        <item name="android:elevation">2dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginHorizontal">@dimen/activity_side_margin</item>
        <item name="android:layout_marginTop">@dimen/activity_side_margin</item>
        <item name="android:layout_marginBottom">@dimen/activity_side_margin</item>
    </style>
    <style name="Settings.Container" parent="Container.Generic">
    </style>

</resources>