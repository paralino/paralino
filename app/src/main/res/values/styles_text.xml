<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextStyle.Regular" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/font_montserrat_regular</item>
        <item name="android:textColor">@color/main_button_text_color</item>
    </style>

    <style name="TextStyle.Medium" parent="TextStyle.Regular">
        <item name="fontFamily">@font/font_montserrat_semibold</item>
    </style>

    <style name="TextStyle.Light" parent="TextStyle.Regular">
        <item name="fontFamily">@font/font_montserrat_light</item>
    </style>

    <style name="TextStyle.Bold" parent="TextStyle.Regular">
        <item name="fontFamily">@font/font_montserrat_bold</item>
    </style>


    <style name="TextStyle.ActionButton" parent="TextStyle.Medium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">10dp</item>
        <item name="background">?selectableItemBackgroundBorderless</item>
        <item name="drawableTint">@color/main_button_text_color</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>