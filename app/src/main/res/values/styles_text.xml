<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextStyle.Regular" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/font_montserrat_regular</item>
        <item name="android:textColor">@color/main_button_text_color</item>
    </style>

    <style name="TextStyle.Medium" parent="TextStyle.Regular">
        <item name="fontFamily">@font/font_montserrat_semibold</item>
    </style>

    <style name="TextStyle.Light" parent="TextStyle.Regular">
        <item name="fontFamily">@font/font_montserrat_light</item>
    </style>

    <style name="TextStyle.Bold" parent="TextStyle.Regular">
        <item name="fontFamily">@font/font_montserrat_bold</item>
    </style>


    <style name="TextStyle.ActionButton" parent="TextStyle.Medium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">10dp</item>
        <item name="background">?selectableItemBackgroundBorderless</item>
        <item name="drawableTint">@color/main_button_text_color</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextStyle.ActionButton.Regular" parent="TextStyle.ActionButton">
        <item name="fontFamily">@font/font_montserrat_regular</item>
    </style>


    <style name="Settings.Title" parent="TextStyle.Bold">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/activity_side_margin</item>
        <item name="android:paddingVertical">@dimen/activity_side_margin_medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/theme_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Settings.Item" parent="TextStyle.Regular">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:background">?selectableItemBackground</item>
        <item name="android:padding">@dimen/activity_side_margin</item>
        <item name="android:drawablePadding">@dimen/activity_side_margin</item>
        <item name="android:drawableTint">@color/theme_medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Settings.Divider" parent="AppTheme">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/theme_background_section_bright</item>
    </style>


    <style name="TextStyle.Input" parent="TextStyle.Medium">
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/main_button_text_color</item>
        <item name="android:textColorHint">@color/theme_medium</item>
        <item name="android:background">@drawable/background_input</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <style name="MainButton" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/font_montserrat_semibold</item>
        <item name="android:background">@drawable/background_button_solid</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/main_button_text_color</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>



</resources>