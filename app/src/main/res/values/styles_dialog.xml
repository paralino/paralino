<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomSheetDialogStyle" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:colorBackground">@color/transparent</item>
        <item name="android:navigationBarColor">@color/theme_lightest</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheetDialogSheetStyle</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheetDialogSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="backgroundTint">@null</item>
    </style>

    <style name="DialogStyleNoDimStatusBar" parent="BottomSheetDialogStyle">
        <item name="android:statusBarColor">@color/backgroundMain</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="DialogStyleNoDim" parent="BottomSheetDialogStyle">
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="TransparentFullScreenDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>


</resources>