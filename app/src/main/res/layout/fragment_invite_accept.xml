<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/AppTheme">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_bottom_sheet"
        android:paddingHorizontal="@dimen/activity_side_margin_small"
        android:paddingTop="@dimen/activity_side_margin_small"
        android:paddingBottom="@dimen/activity_side_margin_large">

        <com.zbapp.locationtrack.ui.shared.bottomsheet.BottomSheetTitleItem
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etInvite"
            style="@style/TextStyle.Input"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="@dimen/activity_side_margin"
            android:layout_marginTop="@dimen/activity_side_margin"
            android:hint="@string/invite_connect_code_placeholder"
            android:stateListAnimator="@null"
            app:endIconMode="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/TextStyle.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@color/transparent"
                android:gravity="center_horizontal"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions|textVisiblePassword|textCapCharacters"
                android:maxLength="10"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textCursorDrawable="@null"
                android:textSize="40sp"
                tools:text="daldk-dasda" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/tvGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_side_margin"
            android:layout_marginTop="@dimen/activity_side_margin"
            android:checkable="false"
            android:ellipsize="end"
            android:text="@string/invite_connect_button_pickGroup"
            android:textColor="@color/primaryTextColor"
            android:visibility="gone"
            app:chipBackgroundColor="@color/accentAlpha20"
            app:chipIcon="@drawable/ic_groups"
            app:chipIconSize="14dp"
            app:chipStrokeColor="@color/theme_accentLightDark"
            app:chipStrokeWidth="1dp"
            app:closeIcon="@drawable/ic_arrow_filled_down"
            app:closeIconEnabled="true"
            app:closeIconTint="@color/primaryTextColor"
            app:iconStartPadding="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etInvite"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInviteImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="@dimen/activity_side_margin"
            android:layout_marginTop="@dimen/activity_side_margin"
            android:background="@drawable/background_input"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="46sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGroup"
            tools:text="🦝"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInviteName"
            style="@style/TextStyle.Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_side_margin"
            android:layout_marginEnd="@dimen/activity_side_margin_small"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:textSize="22sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/tvGroupCount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvInviteImage"
            app:layout_constraintTop_toTopOf="@id/tvInviteImage"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@tools:sample/lorem[20]"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGroupCount"
            style="@style/TextStyle.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:drawableStart="@drawable/ic_groups"
            android:drawablePadding="4dp"
            android:drawableTint="@color/theme_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/theme_medium"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvInviteImage"
            app:layout_constraintStart_toEndOf="@id/tvInviteImage"
            app:layout_constraintTop_toBottomOf="@id/tvInviteName"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="5"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInviteDescription"
            style="@style/TextStyle.Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_side_margin"
            android:layout_marginTop="@dimen/activity_side_margin_medium_large"
            android:alpha="0.6"
            android:background="@drawable/background_input"
            android:backgroundTint="@color/lightRedError"
            android:padding="@dimen/activity_side_margin_small"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvInviteImage"
            tools:text="@string/invite_connect_disclaimer_group"
            tools:visibility="visible" />

        <com.zbapp.locationtrack.ui.shared.ButtonWithProgress
            android:id="@+id/btConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_side_margin_medium_large"
            android:layout_marginEnd="@dimen/activity_side_margin"
            app:buttonTint="@color/accent"
            app:contentTint="@color/light_theme_lightest"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvInviteDescription"
            app:text="@string/button_confirm" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>