<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pinBackground"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:elevation="4dp"
        android:src="@drawable/ic_pin_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.9" />

    <com.zbapp.locationtrack.ui.shared.RoundImageView
        android:id="@+id/ivPinImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="4dp"
        app:backgroundColor="@color/transparent"
        app:tint="@color/light_theme_lightest"
        tools:src="@drawable/ic_user_placeholder_round"
        app:layout_constraintBottom_toBottomOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="@id/pinBackground"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintStart_toStartOf="@id/pinBackground"
        app:layout_constraintTop_toTopOf="@id/pinBackground"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintWidth_percent="0.8" />

</androidx.constraintlayout.widget.ConstraintLayout>