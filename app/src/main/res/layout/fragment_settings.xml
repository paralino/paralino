<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundMain"
    tools:context=".ui.settings.SettingsFragment">

    <include
        android:id="@+id/mainHeader"
        layout="@layout/element_main_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/main_header_height"
            android:paddingBottom="@dimen/bottomBar_spacing"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_side_margin"
                android:layout_marginTop="@dimen/activity_side_margin_large"
                android:background="@drawable/shape_main_rounded_background"
                android:foreground="?selectableItemBackground"
                android:padding="@dimen/activity_side_margin"
                android:elevation="8dp"
                app:layout_constraintTop_toTopOf="parent"
                >

                <com.zbapp.locationtrack.ui.shared.RoundImageView
                    android:id="@+id/ivUserImage"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_user_placeholder_round"
                    app:backgroundColor="@color/theme_background_section_bright"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUserName"
                    style="@style/TextStyle.Medium"
                    android:layout_width="0dp"
                    android:layout_height="30sp"
                    android:layout_marginHorizontal="16dp"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:enabled="false"
                    android:maxLines="1"
                    android:text="@string/settings_profile_name_placeholder"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintBottom_toTopOf="@id/tvUserInfo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivUserImage"
                    app:layout_constraintTop_toTopOf="@id/ivUserImage"
                    app:layout_constraintVertical_chainStyle="packed" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUserInfo"
                    style="@style/TextStyle.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:alpha="0.6"
                    android:enabled="false"
                    android:maxLines="1"
                    android:text="@string/settings_profile_username_placeholder"
                    android:textSize="13sp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="@id/ivUserImage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@id/ivUserImage"
                    app:layout_constraintTop_toBottomOf="@id/tvUserName" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.zbapp.locationtrack.ui.shared.RoundImageView
                android:id="@+id/ivProfileEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:elevation="8dp"
                android:foreground="?selectableItemBackground"
                android:foregroundTint="@color/theme_lightest"
                android:padding="6dp"
                android:src="@drawable/ic_edit"
                app:backgroundColor="@color/transparent"
                app:layout_constraintBottom_toBottomOf="@id/profileHeader"
                app:layout_constraintEnd_toEndOf="@id/profileHeader"
                app:tint="@color/theme_medium" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvUserBadge"
                style="@style/TextStyle.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/shape_rounded_corners_bottom"
                android:backgroundTint="@color/accent"
                android:elevation="4dp"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/profileHeader"
                app:layout_constraintTop_toBottomOf="@id/profileHeader" />

            <LinearLayout
                android:id="@+id/settingHolderLocation"
                style="@style/Settings.Container"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/activity_side_margin_large"
                app:layout_constraintTop_toBottomOf="@id/tvUserBadge">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingLocationTitle"
                    style="@style/Settings.Title"
                    android:text="@string/settings_section_location_title" />

                <View style="@style/Settings.Divider" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingLocation"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_pin_edit"
                    android:text="@string/setting_title_location_defaults" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingSharing"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_pin_sharing"
                    android:text="@string/setting_title_location_sharing" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingHistory"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_history"
                    android:text="@string/setting_title_location_history" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingHolderGeneral"
                style="@style/Settings.Container"
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@id/settingHolderLocation">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingTitle"
                    style="@style/Settings.Title"
                    android:text="@string/settings_section_general_title" />

                <View style="@style/Settings.Divider" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingRate"
                    style="@style/Settings.Item"
                    android:drawableTint="@null"
                    android:drawableStart="@drawable/ic_celebration"
                    android:text="@string/setting_title_rate" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingShare"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_share"
                    android:text="@string/setting_title_share" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingFeedback"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_feedback"
                    android:text="@string/setting_title_feedback" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingHelp"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_help_round"
                    android:text="@string/setting_title_help" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingSourceCode"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_github"
                    android:text="@string/setting_title_sourceCode" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingPrivacyPolicy"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_privacy"
                    android:text="@string/setting_title_privacy" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSettingAck"
                    style="@style/Settings.Item"
                    android:drawableStart="@drawable/ic_library_ack"
                    android:text="@string/setting_title_libraries" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAppInfo"
                style="@style/TextStyle.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginVertical="@dimen/activity_side_margin"
                android:textColor="@color/theme_medium"
                tools:text="@string/app_name"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/settingHolderGeneral"
                 />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>