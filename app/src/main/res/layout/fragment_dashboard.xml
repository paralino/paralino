<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.DashboardFragment">

    <include
        android:id="@+id/mainHeader"
        layout="@layout/element_main_header"
        />

    <include
        android:id="@+id/bannerTracking"
        layout="@layout/element_dashboard_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mainHeader"
        app:layout_constraintEnd_toStartOf="@id/bannerSharing"
        android:layout_marginEnd="@dimen/activity_side_margin_small"
        app:layout_goneMarginEnd="@dimen/activity_side_margin"
        android:layout_marginStart="@dimen/activity_side_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintWidth_max="300dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        />

    <include
        android:id="@+id/bannerSharing"
        layout="@layout/element_dashboard_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/bannerTracking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mainHeader"
        android:layout_marginStart="@dimen/activity_side_margin_small"
        app:layout_goneMarginStart="@dimen/activity_side_margin"
        android:layout_marginEnd="@dimen/activity_side_margin"
        app:layout_constrainedWidth="true"
        />
    
    
    <TextView
        app:layout_goneMarginTop="@dimen/main_header_height"
        android:id="@+id/text_dashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mainHeader" />
</androidx.constraintlayout.widget.ConstraintLayout>