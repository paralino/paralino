<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:animateLayoutChanges="true"
    android:layout_height="match_parent"
    android:background="@color/backgroundMain"
    android:paddingHorizontal="@dimen/activity_side_margin">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLogo"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_side_margin_large"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_logo_full"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etServer"
        style="@style/TextStyle.Input"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:nextFocusDown="@id/etUsername"
        app:endIconMode="clear_text"
        android:hint="@string/login_placeholder_server"
        app:layout_constraintBottom_toTopOf="@id/etUsername"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintVertical_bias="0.6"
        app:layout_constraintVertical_chainStyle="packed">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/TextStyle.Light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            android:textCursorDrawable="@null"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etUsername"
        style="@style/TextStyle.Input"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginTop="@dimen/activity_side_margin_small"
        android:nextFocusDown="@id/etEmail"
        app:endIconMode="custom"
        android:hint="@string/login_placeholder_username_or_random"
        app:endIconDrawable="@drawable/ic_username_random"
        app:layout_constraintBottom_toTopOf="@id/etEmail"
        app:layout_constraintTop_toBottomOf="@id/etServer"
        >

        <com.google.android.material.textfield.TextInputEditText
            style="@style/TextStyle.Light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            android:textCursorDrawable="@null"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
             />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etEmail"
        style="@style/TextStyle.Input"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginTop="@dimen/activity_side_margin_small"
        android:nextFocusDown="@id/etPassword"
        app:endIconMode="clear_text"
        android:hint="@string/login_placeholder_email"
        app:layout_constraintBottom_toTopOf="@id/etPassword"
        app:layout_constraintTop_toBottomOf="@id/etUsername"
        >

        <com.google.android.material.textfield.TextInputEditText
            style="@style/TextStyle.Light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            android:textCursorDrawable="@null"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
             />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etPassword"
        style="@style/TextStyle.Input"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginTop="@dimen/activity_side_margin_small"
        android:nextFocusDown="@id/bLogin"
        android:hint="@string/login_placeholder_password"
        app:endIconMode="password_toggle"
        app:layout_constraintBottom_toTopOf="@id/tvForgotPassword"
        app:layout_constraintTop_toBottomOf="@id/etEmail">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/TextStyle.Light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            android:textCursorDrawable="@null"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
             />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvForgotPassword"
        style="@style/TextStyle.ActionButton.Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/activity_side_margin_small"
        android:layout_marginBottom="@dimen/activity_side_margin"
        android:text="@string/login_button_forgot_password"
        android:textColor="@color/theme_high"
        android:textSize="12sp"
        android:visibility="gone"
        android:background="?selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toTopOf="@id/bLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        tools:visibility="visible" />

    <com.zbapp.locationtrack.ui.shared.ButtonWithProgress
        android:id="@+id/bLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginTop="@dimen/activity_side_margin_large"
        android:layout_marginBottom="@dimen/activity_side_margin_large"
        app:text="@string/login_signup_switch_button_login"
        app:buttonTint="@color/accent"
        app:contentTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/tvSignUpLogin"
        app:layout_constraintTop_toBottomOf="@id/tvForgotPassword" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSignUpLogin"
        style="@style/TextStyle.ActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottomBar_spacing"
        android:text="@string/login_signup_switch_button_signup"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>