<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_bottom_sheet"
        android:paddingHorizontal="@dimen/activity_side_margin_small"
        android:paddingTop="@dimen/activity_side_margin_small"
        android:paddingBottom="@dimen/activity_side_margin_large"
        >

        <com.zbapp.locationtrack.ui.shared.bottomsheet.BottomSheetTitleItem
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/title"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGroupEmoji"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/black"
            android:background="@drawable/background_input"
            android:foreground="?selectableItemBackground"
            android:textSize="28sp"
            android:layout_marginStart="@dimen/activity_side_margin"
            android:layout_marginTop="@dimen/activity_side_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"
            tools:text="🦝" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etGroupName"
            style="@style/TextStyle.Input"
            android:stateListAnimator="@null"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/activity_side_margin_small"
            android:layout_marginEnd="@dimen/activity_side_margin"
            app:endIconMode="none"
            android:hint="@string/group_create_name_placeholder"
            app:layout_constraintBottom_toBottomOf="@id/tvGroupEmoji"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvGroupEmoji"
            app:layout_constraintTop_toTopOf="@id/tvGroupEmoji"
            >

            <com.google.android.material.textfield.TextInputEditText
                style="@style/TextStyle.Light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@color/transparent"
                android:textCursorDrawable="@null"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:maxLength="30"
                android:inputType="textCapWords"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.zbapp.locationtrack.ui.shared.ButtonWithProgress
            android:id="@+id/bCreate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_side_margin_small"
            android:layout_marginEnd="@dimen/activity_side_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGroupEmoji"
            app:buttonTint="@color/accent"
            app:text="@string/group_create_button_text"
            app:contentTint="@color/light_theme_lightest"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>