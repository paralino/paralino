<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".ui.map.MapFragment">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bGroupSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginTop="@dimen/activity_side_margin_small"
        android:background="@drawable/shape_main_rounded_full"
        android:backgroundTint="@color/theme_background_section"
        android:elevation="6dp"
        android:foreground="?selectableItemBackground"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGroupEmoji"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/shape_main_rounded_full"
            android:backgroundTint="@color/theme_background_section_bright"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="🦝" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGroupName"
            style="@style/TextStyle.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_side_margin_small"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textSize="14sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@id/tvGroupCount"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/tvGroupEmoji"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@tools:sample/lorem[0]" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGroupCount"
            style="@style/TextStyle.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/activity_side_margin_small"
            android:layout_marginBottom="6dp"
            android:drawableStart="@drawable/ic_groups_small"
            android:drawableTint="@color/theme_medium"
            app:layout_constraintHorizontal_bias="0"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/theme_medium"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintStart_toStartOf="@id/tvGroupName"
            app:layout_constraintTop_toBottomOf="@id/tvGroupName"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="5 (3 active)" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivArrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/activity_side_margin_small"
            android:rotation="90"
            android:src="@drawable/ic_arrow_light_right"
            android:tint="@color/theme_high"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvShareTime"
        style="@style/TextStyle.Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/activity_side_margin"
        android:layout_marginTop="4dp"
        android:alpha="0.9"
        android:background="@drawable/shape_main_rounded_background"
        android:backgroundTint="@color/theme_accentVeryLightDark"
        android:drawableStart="@drawable/ic_time_20dp"
        android:drawablePadding="4dp"
        android:drawableTint="@color/theme_accentDarkVeryLight"
        android:elevation="6dp"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:paddingVertical="2dp"
        android:paddingStart="@dimen/activity_side_margin_very_small"
        android:paddingEnd="6dp"
        android:textColor="@color/theme_accentDarkVeryLight"
        android:textSize="10sp"
        android:clickable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/fabGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/fabGroup"
        tools:text="Jan 15, 2023\n15:00"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/activity_side_margin"
        android:layout_marginBottom="@dimen/activity_side_margin_small"
        app:layout_goneMarginBottom="@dimen/bottomBar_spacing"
        android:src="@drawable/ic_circle_group"
        app:backgroundTint="@color/selected_item_color"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/rvUsers"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/selected_pin_color" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/bottomBar_spacing_small"
        android:paddingBottom="@dimen/activity_side_margin_small"
        android:visibility="gone"
        android:orientation="horizontal"
        />

</androidx.constraintlayout.widget.ConstraintLayout>