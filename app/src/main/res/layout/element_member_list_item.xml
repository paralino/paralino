<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        style="@style/Container.Generic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_side_margin_very_small"
        android:layout_marginBottom="@dimen/activity_side_margin_medium"
        android:animateLayoutChanges="true"
        android:foreground="?selectableItemBackground"
        android:padding="@dimen/activity_side_margin"
        android:theme="@style/AppTheme"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvUserEmoji"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/background_input"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="🦝" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMemberName"
            style="@style/TextStyle.Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_side_margin"
            android:layout_marginEnd="@dimen/activity_side_margin_small"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/tvUserEmoji"
            app:layout_constraintEnd_toStartOf="@id/bAction"
            app:layout_constraintStart_toEndOf="@id/tvUserEmoji"
            app:layout_constraintTop_toTopOf="@id/tvUserEmoji"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@tools:sample/lorem[20]" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bAction"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_filled_down"
            app:layout_constraintBottom_toBottomOf="@id/tvUserEmoji"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvUserEmoji" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bRemove"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_side_margin_medium"
            android:text="@string/group_members_item_remove_button"
            android:textColor="@color/highlightRed"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_person_remove"
            app:iconTint="@color/highlightRed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUserEmoji"
            app:layout_constraintVertical_bias="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</merge>