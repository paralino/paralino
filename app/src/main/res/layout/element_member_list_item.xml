<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        style="@style/Container.Generic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_side_margin_very_small"
        android:layout_marginBottom="@dimen/activity_side_margin_medium"
        android:animateLayoutChanges="true"
        android:foreground="?selectableItemBackground"
        android:padding="0dp"
        android:theme="@style/AppTheme"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvUserEmoji"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/activity_side_margin"
            android:layout_marginTop="@dimen/activity_side_margin"
            android:background="@drawable/background_input"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="28sp"
            app:layout_constraintBottom_toTopOf="@id/tvBatteryInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginBottom="@dimen/activity_side_margin"
            tools:text="🦝" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBatteryInfo"
            style="@style/TextStyle.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/activity_side_margin_medium"
            android:drawableStart="@drawable/ic_battery_full"
            android:drawablePadding="4dp"
            android:drawableTint="@color/secondaryTextColor"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="2dp"
            android:paddingVertical="0dp"
            android:textColor="@color/secondaryTextColor"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/optionsBarrier"
            app:layout_constraintEnd_toEndOf="@id/tvUserEmoji"
            app:layout_constraintStart_toStartOf="@id/tvUserEmoji"
            app:layout_constraintTop_toBottomOf="@id/tvUserEmoji"
            tools:text="68%"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_side_margin"
            android:layout_marginVertical="@dimen/activity_side_margin_medium"
            app:layout_constraintBottom_toTopOf="@id/optionsBarrier"
            app:layout_constraintEnd_toStartOf="@id/bAction"
            app:layout_constraintStart_toEndOf="@id/tvUserEmoji"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMemberName"
                style="@style/TextStyle.Regular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/tvUserStatus"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="@tools:sample/lorem[2]" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvUserStatus"
                style="@style/TextStyle.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_main_rounded_background"
                android:backgroundTint="@color/theme_background_section_bright"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/theme_medium"
                android:textSize="11sp"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@id/tvUserTimeInfo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMemberName"
                tools:text="User is inactive"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvUserTimeInfo"
                style="@style/TextStyle.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingVertical="2dp"
                android:textColor="@color/secondaryTextColor"
                android:textSize="11sp"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUserStatus"
                tools:text="@tools:sample/lorem[20]"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bAction"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="@dimen/activity_side_margin_small"
            android:src="@drawable/ic_arrow_filled_down"
            app:layout_constraintBottom_toBottomOf="@id/tvUserEmoji"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvUserEmoji" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/optionsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="bRemove"
            app:layout_constraintTop_toTopOf="@id/bRemove" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bRemove"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_side_margin_medium"
            android:layout_marginStart="@dimen/activity_side_margin"
            android:layout_marginBottom="@dimen/activity_side_margin_small"
            android:text="@string/group_members_item_remove_button"
            android:textColor="@color/highlightRed"
            android:visibility="gone"
            app:cornerRadius="12dp"
            android:textSize="12sp"
            app:icon="@drawable/ic_person_remove"
            app:iconTint="@color/highlightRed"
            app:iconSize="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUserEmoji"
            app:layout_constraintVertical_bias="1"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</merge>