<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_close"
        app:titleCentered="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="@dimen/activity_side_margin_large"
        android:paddingBottom="@dimen/bottomBar_spacing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGroupEmoji"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/background_input"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/activity_side_margin"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="70sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="🦝" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGroupName"
                style="@style/TextStyle.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_side_margin"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="3"
                android:textSize="18sp"
                android:layout_marginEnd="@dimen/activity_side_margin"
                app:layout_constraintBottom_toBottomOf="@id/tvGroupEmoji"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvGroupEmoji"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="@tools:sample/lorem[20]" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapHolder"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="48dp"
                android:layout_marginHorizontal="@dimen/activity_side_margin"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/tvGroupEmoji">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:src="@drawable/image_map_wide_placeholder" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@color/alpha_grey_strong" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextStyle.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableEnd="@drawable/ic_arrow_light_right"
                    android:drawableTint="@color/accentVeryLight"
                    android:text="@string/group_details_map_action_button"
                    android:textColor="@color/accentVeryLight"
                    android:textSize="16sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.chip.Chip
                android:id="@+id/bMembers"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:textAppearance="@style/TextStyle.Regular"
                android:layout_marginHorizontal="@dimen/activity_side_margin"
                android:layout_marginTop="@dimen/activity_side_margin"
                android:checkable="false"
                android:ellipsize="end"
                tools:text="@string/group_details_section_members_title"
                android:textColor="@color/accent"
                android:textSize="16sp"
                app:chipBackgroundColor="@color/transparent"
                app:chipIcon="@drawable/ic_groups"
                android:textAllCaps="true"
                style="@style/TextStyle.Medium"
                app:chipIconSize="16dp"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="8dp"
                app:closeIcon="@drawable/ic_arrow_light_right"
                app:closeIconEnabled="true"
                app:closeIconTint="@color/accent"
                app:chipIconTint="@color/accent"
                app:iconStartPadding="12dp"
                android:elevation="0dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@id/bAddMember"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mapHolder"
                app:layout_constraintVertical_bias="1"
                 />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bAddMember"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/theme_accentVeryLightDark"
                android:gravity="start|center_vertical"
                android:padding="@dimen/activity_side_margin_medium_large"
                android:text="@string/group_details_add_member_button"
                android:textColor="@color/theme_accentDarkVeryLight"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_person_add"
                android:layout_marginHorizontal="@dimen/activity_side_margin"
                app:iconPadding="@dimen/activity_side_margin_medium"
                android:elevation="2dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:iconTint="@color/theme_accentDarkVeryLight"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bMembers"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/bShareStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginBottom="@dimen/bottomBar_spacing"
        android:backgroundTint="@color/accent"
        android:enabled="true"
        android:text="@string/groups_sharing_title"
        app:icon="@drawable/ic_pin_sharing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>