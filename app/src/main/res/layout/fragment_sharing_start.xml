<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/groups_sharing_title"
        app:titleCentered="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottomBar_spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWith"
                style="@style/TextStyle.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_side_margin"
                android:paddingVertical="12dp"
                android:text="@string/groups_sharing_section_title_group"
                android:textColor="@color/theme_medium"
                android:textSize="12sp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.zbapp.locationtrack.ui.dashboard.GroupListItem
                android:id="@+id/groupPicker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toBottomOf="@id/tvWith" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvExtraHeader"
                style="@style/TextStyle.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_side_margin"
                android:paddingTop="@dimen/activity_side_margin"
                android:text="@string/groups_sharing_section_title_extra"
                android:textColor="@color/theme_medium"
                android:textSize="12sp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progressBackground" />

            <include
                android:id="@+id/switchBattery"
                layout="@layout/element_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExtraHeader" />

            <View
                android:id="@+id/progressFocus"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:alpha="0"
                android:background="@color/backgroundMain"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/progressBackground"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginHorizontal="@dimen/activity_side_margin_medium"
                android:background="@drawable/shape_main_rounded_full"
                android:backgroundTint="@color/theme_light"
                android:stateListAnimator="@animator/elevation_animator_seekbar_background"
                app:layout_constraintBottom_toBottomOf="@id/timeSeekBar"
                app:layout_constraintTop_toTopOf="@id/timeSeekBar" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDurationHeader"
                style="@style/TextStyle.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_side_margin"
                android:paddingVertical="12dp"
                android:text="@string/groups_sharing_section_title_duration"
                android:textColor="@color/theme_medium"
                android:textSize="12sp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/groupPicker" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDuration"
                style="@style/TextStyle.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_side_margin"
                android:background="@drawable/shape_main_rounded_full"
                android:backgroundTint="@color/accent"
                android:drawableStart="@drawable/ic_time"
                android:drawablePadding="8dp"
                android:drawableTint="@color/accentDark"
                android:includeFontPadding="false"
                android:paddingVertical="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@animator/elevation_animator_seekbar_background"
                android:textColor="@color/light_theme_light"
                android:textSize="32sp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDurationHeader"
                tools:text="8 hours" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/timeSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_side_margin_medium"
                android:elevation="6dp"
                android:progressBackgroundTint="@color/transparent"
                android:progressTint="@color/transparent"
                android:thumb="@drawable/shape_progress_thumb"
                android:thumbOffset="-2dp"
                app:layout_constraintTop_toBottomOf="@id/tvDuration"
                tools:progress="0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/bShareStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginBottom="@dimen/bottomBar_spacing"
        android:backgroundTint="@color/fab_background_color"
        android:enabled="false"
        android:text="@string/groups_sharing_button_start"
        app:icon="@drawable/ic_pin_sharing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>