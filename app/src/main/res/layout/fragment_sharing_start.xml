<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.zbapp.locationtrack.ui.shared.RoundImageView
        android:id="@+id/ivClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="@dimen/activity_side_margin_small"
        android:foreground="?selectableItemBackground"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        app:backgroundColor="@color/theme_light"
        app:cornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="@dimen/activity_side_margin"
        android:paddingBottom="@dimen/bottomBar_spacing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivClose">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWith"
                style="@style/TextStyle.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_side_margin"
                android:paddingVertical="8dp"
                android:text="@string/groups_sharing_section_title_group"
                android:textColor="@color/theme_medium"
                android:textSize="12sp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.zbapp.locationtrack.ui.dashboard.GroupListItem
                android:id="@+id/groupPicker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toBottomOf="@id/tvWith" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDurationHeader"
                style="@style/TextStyle.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_side_margin"
                android:paddingVertical="8dp"
                android:text="@string/groups_sharing_section_title_duration"
                android:textColor="@color/theme_medium"
                android:textSize="12sp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/groupPicker" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDuration"
                style="@style/TextStyle.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_side_margin"
                android:background="@drawable/shape_main_rounded_full"
                android:backgroundTint="@color/accent"
                android:drawableStart="@drawable/ic_time"
                android:drawablePadding="8dp"
                android:drawableTint="@color/accentDark"
                android:includeFontPadding="false"
                android:paddingVertical="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:textColor="@color/light_theme_light"
                android:textSize="20sp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDurationHeader"
                tools:text="8 hours" />

            <FrameLayout
                android:id="@+id/progressHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_side_margin"
                android:layout_marginTop="@dimen/activity_side_margin_very_small"
                android:background="@drawable/background_bottom_navigation"
                android:backgroundTint="@color/theme_light"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvDuration">

                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/timeSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressBackgroundTint="@color/transparent"
                    android:progressTint="@color/transparent"
                    android:thumb="@drawable/shape_progress_thumb"
                    tools:progress="0" />
            </FrameLayout>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvExtraHeader"
                style="@style/TextStyle.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_side_margin"
                android:paddingTop="@dimen/activity_side_margin"
                android:text="@string/groups_sharing_section_title_extra"
                android:textColor="@color/theme_medium"
                android:textSize="12sp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progressHolder" />

            <include
                android:id="@+id/switchBattery"
                layout="@layout/element_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExtraHeader" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/bShareStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_side_margin"
        android:layout_marginBottom="@dimen/bottomBar_spacing"
        android:backgroundTint="@color/fab_background_color"
        android:enabled="false"
        android:text="@string/groups_sharing_button_start"
        app:icon="@drawable/ic_pin_sharing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>