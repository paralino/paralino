<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/activity_side_margin"
    android:background="@drawable/shape_main_rounded_background"
    android:backgroundTint="@color/theme_light"
    android:foreground="?selectableItemBackgroundBorderless"
    android:elevation="8dp"
    android:padding="@dimen/activity_side_margin_medium">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLocationStatus"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:src="@drawable/ic_stop_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLocationStatusTitle"
        style="@style/TextStyle.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/activity_side_margin_small"
        android:text="@string/location_banner_sharing_active"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/tvLocationStatusSubtitle"
        app:layout_constraintStart_toEndOf="@id/ivLocationStatus"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLocationStatusSubtitle"
        style="@style/TextStyle.Light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/activity_side_margin_small"
        android:text="@string/location_banner_info_stop"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivLocationStatus"
        app:layout_constraintTop_toBottomOf="@id/tvLocationStatusTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>