<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppThemeBase" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/theme_high</item>
        <item name="colorPrimaryVariant">@color/theme_highest</item>
        <item name="colorOnPrimary">@color/theme_light</item>

        <item name="colorSurface">@color/theme_lightest</item>
        <item name="colorOnSurface">@color/theme_highest</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accentDark</item>
        <item name="colorOnSecondary">@color/theme_lightest</item>

        <item name="colorControlNormal">?android:textColorPrimary</item>
        <item name="colorControlHighlight">@color/alpha_grey_highlight</item>

        <item name="android:textColorPrimary">@color/primaryTextColor</item>
        <item name="android:textColorSecondary">@color/secondaryTextColor</item>

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/theme_lightest</item>
        <item name="android:windowLightStatusBar">@bool/app_windowLightNavigationBar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <item name="android:navigationBarColor">@color/theme_lightest</item>
        <item name="android:navigationBarDividerColor">@color/theme_lightest</item>
        <item name="android:windowLightNavigationBar">@bool/app_windowLightNavigationBar</item>

    </style>

    <style name="AppTheme" parent="AppThemeBase">
    </style>

</resources>